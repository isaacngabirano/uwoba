# ============================================================
# RHEA BEAUTY SHOP — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env.local for local dev
# Add these same keys in Vercel dashboard for production
# ============================================================

# --- SUPABASE (required) ------------------------------------
# Get these from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- ADMIN LOGIN (change password before going live!) -------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_SECRET=rhea_admin_secret_change_this_in_production

# --- WHATSAPP NOTIFICATIONS (CallMeBot — free) --------------
# Setup: WhatsApp "I allow callmebot to send me messages" → +34 644 60 96 99
# They reply with your API key
CALLMEBOT_API_KEY=your_callmebot_api_key_here
ADMIN_WHATSAPP_NUMBER=256700000000
# Format: country code + number, no + sign. Uganda = 256XXXXXXXXX

# --- MARZ PAYMENT GATEWAY (add when ready) ------------------
MARZ_API_KEY=
MARZ_API_SECRET=
MARZ_BASE_URL=https://api.marz.ug
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
